generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueState {
  REPORTED
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  ESCALATED

  @@map("issue_state")
}

enum IssueSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL

  @@map("issue_severity")
}

enum OperationalTaskKind {
  PLAN
  STAFFING
  SERVICE
  STOCK

  @@map("operational_task_kind")
}

enum OperationalTaskState {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE

  @@map("operational_task_state")
}

enum StaffShiftState {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("staff_shift_state")
}

enum StaffShiftResponse {
  PENDING
  ACKNOWLEDGED
  DECLINED

  @@map("staff_shift_response")
}

enum StaffAttendanceState {
  NOT_STARTED
  CHECKED_IN
  CHECKED_OUT

  @@map("staff_attendance_state")
}

enum AttachmentStatus {
  PENDING_UPLOAD
  READY

  @@map("attachment_status")
}

model Organization {
  id                    String                     @id @default(uuid()) @db.Uuid
  slug                  String?                    @unique
  name                  String
  createdAt             DateTime                   @default(now()) @map("created_at")
  venues                Venue[]
  people                Person[]
  tasks                 OperationalTask[]
  taskAuditEvents       OperationalTaskAudit[]
  notifications         UserNotification[]
  attachments           IssueAttachment[]
  integrationEvents     ExternalIntegrationEvent[]
  pushDevices           PushDevice[]
  setupAuditEvents      TenantSetupAuditEvent[]
  staffShifts           StaffShift[]
  staffShiftAuditEvents StaffShiftAuditEvent[]
  staffUnavailability  StaffUnavailability[]
  staffUnavailabilityAudits StaffUnavailabilityAudit[]

  @@map("organizations")
}

model Venue {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  events         Event[]
  locations      Location[]
  tasks          OperationalTask[]
  staffShifts    StaffShift[]

  @@index([organizationId])
  @@map("venues")
}

model Event {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  venueId           String                     @map("venue_id") @db.Uuid
  name              String
  startsAt          DateTime                   @map("starts_at")
  venue             Venue                      @relation(fields: [venueId], references: [id])
  issues            Issue[]
  tasks             OperationalTask[]
  notifications     UserNotification[]
  attachments       IssueAttachment[]
  integrationEvents ExternalIntegrationEvent[]
  staffShifts       StaffShift[]

  @@index([organizationId, venueId])
  @@map("events")
}

model Location {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  venueId        String            @map("venue_id") @db.Uuid
  name           String
  venue          Venue             @relation(fields: [venueId], references: [id])
  issues         Issue[]
  tasks          OperationalTask[]
  staffShifts    StaffShift[]

  @@unique([id, venueId])
  @@index([organizationId, venueId])
  @@map("locations")
}

model Person {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  externalSubject String             @map("external_subject")
  email           String
  displayName     String             @map("display_name")
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  auditEvents     PersonAuditEvent[]
  organization    Organization       @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, externalSubject])
  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@map("people")
}

model PersonAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  actorId        String   @map("actor_id")
  action         String
  changedFields  String[] @map("changed_fields")
  createdAt      DateTime @default(now()) @map("created_at")
  person         Person   @relation(fields: [personId, organizationId], references: [id, organizationId], map: "person_audit_events_person_tenant_fk")

  @@index([organizationId, personId, createdAt])
  @@map("person_audit_events")
}

model Issue {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  eventId        String             @map("event_id") @db.Uuid
  venueId        String             @map("venue_id") @db.Uuid
  locationId     String?            @map("location_id") @db.Uuid
  title          String
  description    String
  category       String
  severity       IssueSeverity
  state          IssueState         @default(REPORTED)
  reporterId     String             @map("reporter_id")
  ownerId        String?            @map("owner_id")
  escalationNote String?            @map("escalation_note")
  resolutionNote String?            @map("resolution_note")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  event          Event              @relation(fields: [eventId], references: [id])
  location       Location?          @relation(fields: [locationId], references: [id])
  auditEvents    IssueAuditEvent[]
  notifications  UserNotification[]
  attachments    IssueAttachment[]

  @@index([organizationId, eventId, state])
  @@index([organizationId, ownerId])
  @@map("issues")
}

model IssueAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  issueId        String   @map("issue_id") @db.Uuid
  actorId        String   @map("actor_id")
  action         String
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  issue          Issue    @relation(fields: [issueId], references: [id])

  @@index([organizationId, issueId, createdAt])
  @@map("issue_audit_events")
}

model CommandReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  fingerprint    String
  action         String
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, key])
  @@map("command_receipts")
}

model IssueDomainEvent {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  issueId        String   @map("issue_id") @db.Uuid
  action         String
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, eventId, id])
  @@map("issue_events")
}

model OperationalTask {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  venueId          String                 @map("venue_id") @db.Uuid
  eventId          String                 @map("event_id") @db.Uuid
  locationId       String?                @map("location_id") @db.Uuid
  kind             OperationalTaskKind
  state            OperationalTaskState   @default(OPEN)
  title            String
  description      String                 @default("")
  ownerId          String?                @map("owner_id")
  dueAt            DateTime?              @map("due_at")
  expectedQuantity Decimal?               @map("expected_quantity") @db.Decimal(12, 3)
  actualQuantity   Decimal?               @map("actual_quantity") @db.Decimal(12, 3)
  unit             String?
  externalSource   String?                @map("external_source")
  externalTaskId   String?                @map("external_task_id")
  metadata         Json                   @default("{}") @db.JsonB
  createdBy        String                 @map("created_by")
  updatedBy        String                 @map("updated_by")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  organization     Organization           @relation(fields: [organizationId], references: [id])
  venue            Venue                  @relation(fields: [venueId], references: [id])
  event            Event                  @relation(fields: [eventId], references: [id])
  location         Location?              @relation(fields: [locationId, venueId], references: [id, venueId], map: "operational_task_location_venue_fk")
  auditEvents      OperationalTaskAudit[]

  @@unique([id, organizationId])
  @@unique([organizationId, externalSource, externalTaskId], map: "operational_tasks_org_external_task_key")
  @@index([organizationId, eventId, kind, state])
  @@index([organizationId, ownerId, dueAt])
  @@map("operational_tasks")
}

model OperationalTaskAudit {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  taskId         String          @map("task_id") @db.Uuid
  actorId        String          @map("actor_id")
  action         String
  before         Json?           @db.JsonB
  after          Json?           @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at")
  organization   Organization    @relation(fields: [organizationId], references: [id])
  task           OperationalTask @relation(fields: [taskId, organizationId], references: [id, organizationId], map: "operational_task_audit_tenant_fk")

  @@index([organizationId, taskId, createdAt])
  @@map("operational_task_audit_events")
}

model StaffShift {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  venueId          String                 @map("venue_id") @db.Uuid
  eventId          String                 @map("event_id") @db.Uuid
  locationId       String?                @map("location_id") @db.Uuid
  assignedSubject  String?                @map("assigned_subject")
  role             String
  instructions     String                 @default("")
  startsAt         DateTime               @map("starts_at")
  endsAt           DateTime               @map("ends_at")
  state            StaffShiftState        @default(DRAFT)
  response         StaffShiftResponse     @default(PENDING)
  attendance       StaffAttendanceState   @default(NOT_STARTED)
  revision         Int                    @default(1)
  responseRevision Int?                   @map("response_revision")
  checkedInAt      DateTime?              @map("checked_in_at")
  checkedOutAt     DateTime?              @map("checked_out_at")
  createdBy        String                 @map("created_by")
  updatedBy        String                 @map("updated_by")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  organization     Organization           @relation(fields: [organizationId], references: [id])
  venue            Venue                  @relation(fields: [venueId], references: [id])
  event            Event                  @relation(fields: [eventId], references: [id])
  location         Location?              @relation(fields: [locationId, venueId], references: [id, venueId], map: "staff_shifts_location_venue_fk")
  auditEvents      StaffShiftAuditEvent[]
  notifications    UserNotification[]

  @@unique([id, organizationId])
  @@unique([id, eventId, organizationId], map: "staff_shifts_id_event_organization_key")
  @@index([organizationId, eventId, state, startsAt])
  @@index([organizationId, assignedSubject, startsAt])
  @@map("staff_shifts")
}

model StaffUnavailability {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subject        String
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  note           String   @default("")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  auditEvents    StaffUnavailabilityAudit[]

  @@unique([id, organizationId])
  @@index([organizationId, subject, startsAt, endsAt])
  @@map("staff_unavailability")
}

model StaffUnavailabilityAudit {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  unavailabilityId  String   @map("unavailability_id") @db.Uuid
  actorId           String   @map("actor_id")
  action            String
  createdAt         DateTime @default(now()) @map("created_at")
  organization      Organization @relation(fields: [organizationId], references: [id])
  unavailability    StaffUnavailability @relation(fields: [unavailabilityId, organizationId], references: [id, organizationId], map: "staff_unavailability_audit_tenant_fk")

  @@index([organizationId, unavailabilityId, createdAt])
  @@map("staff_unavailability_audit")
}

model StaffShiftAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  shiftId        String       @map("shift_id") @db.Uuid
  actorId        String       @map("actor_id")
  action         String
  before         Json?        @db.JsonB
  after          Json?        @db.JsonB
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  shift          StaffShift   @relation(fields: [shiftId, organizationId], references: [id, organizationId], map: "staff_shift_audit_tenant_fk")

  @@index([organizationId, shiftId, createdAt])
  @@map("staff_shift_audit_events")
}

model UserNotification {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  eventId          String       @map("event_id") @db.Uuid
  issueId          String?      @map("issue_id") @db.Uuid
  shiftId          String?      @map("shift_id") @db.Uuid
  recipientSubject String       @map("recipient_subject")
  kind             String
  title            String
  body             String
  createdAt        DateTime     @default(now()) @map("created_at")
  readAt           DateTime?    @map("read_at")
  organization     Organization @relation(fields: [organizationId], references: [id])
  event            Event        @relation(fields: [eventId], references: [id])
  issue            Issue?       @relation(fields: [issueId], references: [id])
  shift            StaffShift?  @relation(fields: [shiftId, eventId, organizationId], references: [id, eventId, organizationId], map: "user_notifications_shift_event_tenant_fk")

  @@index([organizationId, recipientSubject, readAt, createdAt(sort: Desc)])
  @@map("user_notifications")
}

model IssueAttachment {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  issueId          String           @map("issue_id") @db.Uuid
  clientId         String           @map("client_id") @db.Uuid
  uploadedBy       String           @map("uploaded_by")
  fileName         String           @map("file_name")
  contentType      String           @map("content_type")
  sizeBytes        Int              @map("size_bytes")
  sha256           String
  storageObjectKey String           @unique @map("storage_object_key")
  status           AttachmentStatus @default(PENDING_UPLOAD)
  createdAt        DateTime         @default(now()) @map("created_at")
  readyAt          DateTime?        @map("ready_at")
  organization     Organization     @relation(fields: [organizationId], references: [id])
  event            Event            @relation(fields: [eventId], references: [id])
  issue            Issue            @relation(fields: [issueId], references: [id])

  @@unique([issueId, clientId])
  @@index([organizationId, eventId, issueId, createdAt])
  @@map("issue_attachments")
}

model ExternalIntegrationEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  source         String
  externalId     String       @map("external_id")
  eventType      String       @map("event_type")
  occurredAt     DateTime     @map("occurred_at")
  payload        Json         @db.JsonB
  bodySha256     String       @map("body_sha256")
  receivedAt     DateTime     @default(now()) @map("received_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  event          Event        @relation(fields: [eventId], references: [id])

  @@unique([organizationId, source, externalId])
  @@index([organizationId, eventId, occurredAt(sort: Desc)])
  @@map("external_integration_events")
}

model PushDevice {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  subject           String
  installationId    String       @map("installation_id") @db.Uuid
  registrationToken String       @map("registration_token")
  tokenSha256       String       @map("token_sha256")
  platform          String
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, installationId])
  @@unique([organizationId, tokenSha256])
  @@index([organizationId, subject, active])
  @@map("push_devices")
}

model TenantSetupAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String       @map("actor_id")
  action         String
  resourceType   String       @map("resource_type")
  resourceId     String       @map("resource_id") @db.Uuid
  eventId        String?      @map("event_id") @db.Uuid
  changedFields  String[]     @default([]) @map("changed_fields")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("tenant_setup_audit_events")
}
