generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueState {
  REPORTED
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  ESCALATED

  @@map("issue_state")
}

enum IssueSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL

  @@map("issue_severity")
}

enum OperationalTaskKind {
  PLAN
  STAFFING
  SERVICE
  STOCK

  @@map("operational_task_kind")
}

enum OperationalTaskState {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE

  @@map("operational_task_state")
}

enum StaffShiftState {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("staff_shift_state")
}

enum StaffShiftResponse {
  PENDING
  ACKNOWLEDGED
  DECLINED

  @@map("staff_shift_response")
}

enum StaffAttendanceState {
  NOT_STARTED
  CHECKED_IN
  CHECKED_OUT

  @@map("staff_attendance_state")
}

enum StaffBreakKind {
  REST
  MEAL

  @@map("staff_break_kind")
}

enum StaffAttendanceAction {
  CHECK_IN
  CHECK_OUT

  @@map("staff_attendance_action")
}

enum StaffAttendanceClaimStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED

  @@map("staff_attendance_claim_status")
}

enum AttachmentStatus {
  PENDING_UPLOAD
  READY

  @@map("attachment_status")
}

enum HospitalityOrderState {
  AWAITING_APPROVAL
  SUBMITTED
  ACCEPTED
  PREPARING
  READY
  PARTIALLY_DISTRIBUTED
  DISTRIBUTED
  PICKED_UP
  REJECTED
  CANCELLED

  @@map("hospitality_order_state")
}

enum VendorStaffingRequestState {
  SENT
  ACKNOWLEDGED
  PARTIALLY_COMMITTED
  COMMITTED
  DECLINED
  CANCELLED
  FULFILLED

  @@map("vendor_staffing_request_state")
}

model Organization {
  id                           String                        @id @default(uuid()) @db.Uuid
  slug                         String?                       @unique
  name                         String
  minimumRestMinutes           Int?                          @map("minimum_rest_minutes") @db.SmallInt
  createdAt                    DateTime                      @default(now()) @map("created_at")
  venues                       Venue[]
  people                       Person[]
  tasks                        OperationalTask[]
  taskAuditEvents              OperationalTaskAudit[]
  notifications                UserNotification[]
  attachments                  IssueAttachment[]
  integrationEvents            ExternalIntegrationEvent[]
  pushDevices                  PushDevice[]
  setupAuditEvents             TenantSetupAuditEvent[]
  staffShifts                  StaffShift[]
  staffShiftAuditEvents        StaffShiftAuditEvent[]
  staffingDemands              StaffingDemand[]
  staffingDemandAudits         StaffingDemandAudit[]
  staffUnavailability          StaffUnavailability[]
  staffUnavailabilityAudits    StaffUnavailabilityAudit[]
  qualifications               PersonQualification[]
  hospitalityApprovalThreshold Decimal?                      @map("hospitality_approval_threshold") @db.Decimal(12, 2)
  hospitalityCurrencyCode      String                         @default("USD") @map("hospitality_currency_code") @db.Char(3)
  hospitalityMenuItems         HospitalityMenuItem[]
  hospitalityOrders            HospitalityOrder[]
  hospitalityOrderAudits       HospitalityOrderAudit[]
  hospitalityOrderFulfillments HospitalityOrderFulfillment[]
  hospitalityDeliveryReceipts  HospitalityDeliveryReceipt[]
  staffingVendorRequests       StaffingVendorRequest[]

  @@map("organizations")
}

model Venue {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  name                   String
  organization           Organization            @relation(fields: [organizationId], references: [id])
  events                 Event[]
  locations              Location[]
  tasks                  OperationalTask[]
  staffShifts            StaffShift[]
  staffingDemands        StaffingDemand[]
  hospitalityOrders      HospitalityOrder[]
  vendorStaffingRequests StaffingVendorRequest[]
  hospitalityMenuItems   HospitalityMenuItem[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("venues")
}

model Event {
  id                     String                     @id @default(uuid()) @db.Uuid
  organizationId         String                     @map("organization_id") @db.Uuid
  venueId                String                     @map("venue_id") @db.Uuid
  name                   String
  startsAt               DateTime                   @map("starts_at")
  venue                  Venue                      @relation(fields: [venueId], references: [id])
  issues                 Issue[]
  tasks                  OperationalTask[]
  notifications          UserNotification[]
  attachments            IssueAttachment[]
  integrationEvents      ExternalIntegrationEvent[]
  staffShifts            StaffShift[]
  staffingDemands        StaffingDemand[]
  hospitalityOrders      HospitalityOrder[]
  closeout               EventCloseout?
  vendorStaffingRequests StaffingVendorRequest[]

  @@unique([id, venueId, organizationId])
  @@index([organizationId, venueId])
  @@map("events")
}

model EventCloseout {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  venueId        String                     @map("venue_id") @db.Uuid
  eventId        String                     @unique @map("event_id") @db.Uuid
  state          String                     @default("OPEN")
  openedBy       String                     @map("opened_by")
  openedAt       DateTime                   @default(now()) @map("opened_at")
  finalizedBy    String?                    @map("finalized_by")
  finalizedAt    DateTime?                  @map("finalized_at")
  summary        String                     @default("")
  event          Event                      @relation(fields: [eventId, venueId, organizationId], references: [id, venueId, organizationId])
  followups      EventCloseoutFollowup[]
  auditEvents    EventCloseoutAudit[]
  corrections    EventPostCloseCorrection[]

  @@unique([id, organizationId])
  @@unique([eventId, organizationId])
  @@unique([eventId, venueId, organizationId])
  @@index([organizationId, state, openedAt])
  @@map("event_closeouts")
}

model EventCloseoutFollowup {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  closeoutId     String        @map("closeout_id") @db.Uuid
  sourceType     String        @map("source_type")
  sourceId       String        @map("source_id")
  title          String
  state          String        @default("OPEN")
  ownerSubject   String?       @map("owner_subject")
  dueAt          DateTime?     @map("due_at")
  reason         String        @default("")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  closeout       EventCloseout @relation(fields: [closeoutId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([closeoutId, sourceType, sourceId])
  @@index([organizationId, closeoutId, state])
  @@map("event_closeout_followups")
}

model EventCloseoutAudit {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  closeoutId     String        @map("closeout_id") @db.Uuid
  actorId        String        @map("actor_id")
  action         String
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime      @default(now()) @map("created_at")
  closeout       EventCloseout @relation(fields: [closeoutId, organizationId], references: [id, organizationId])

  @@index([organizationId, closeoutId, createdAt])
  @@map("event_closeout_audit")
}

model EventPostCloseCorrection {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  sourceType     String        @map("source_type")
  sourceId       String        @map("source_id")
  headline       String
  correction     String
  reason         String
  createdBy      String        @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  closeout       EventCloseout @relation(fields: [eventId, organizationId], references: [eventId, organizationId])

  @@index([organizationId, eventId, createdAt])
  @@map("event_post_close_corrections")
}

model StaffingVendorRequest {
  id                 String                       @id @default(uuid()) @db.Uuid
  organizationId     String                       @map("organization_id") @db.Uuid
  venueId            String                       @map("venue_id") @db.Uuid
  eventId            String                       @map("event_id") @db.Uuid
  locationId         String?                      @map("location_id") @db.Uuid
  demandId           String                       @map("demand_id") @db.Uuid
  requesterSubject   String                       @map("requester_subject")
  vendorSubject      String                       @map("vendor_subject")
  requestedHeadcount Int                          @map("requested_headcount") @db.SmallInt
  committedHeadcount Int                          @default(0) @map("committed_headcount") @db.SmallInt
  responseDueAt      DateTime                     @map("response_due_at")
  instructions       String                       @default("")
  state              VendorStaffingRequestState   @default(SENT)
  responseReason     String                       @default("") @map("response_reason")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  respondedAt        DateTime?                    @map("responded_at")
  fulfilledAt        DateTime?                    @map("fulfilled_at")
  cancelledAt        DateTime?                    @map("cancelled_at")
  organization       Organization                 @relation(fields: [organizationId], references: [id])
  venue              Venue                        @relation(fields: [venueId, organizationId], references: [id, organizationId])
  event              Event                        @relation(fields: [eventId, venueId, organizationId], references: [id, venueId, organizationId])
  location           Location?                    @relation(fields: [locationId, venueId, organizationId], references: [id, venueId, organizationId])
  demand             StaffingDemand               @relation(fields: [demandId, eventId, organizationId], references: [id, eventId, organizationId])
  vendor             Person                       @relation(fields: [organizationId, vendorSubject], references: [organizationId, externalSubject])
  auditEvents        StaffingVendorRequestAudit[]

  @@unique([id, organizationId])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, state, responseDueAt])
  @@index([organizationId, vendorSubject, state, responseDueAt])
  @@map("staffing_vendor_requests")
}

model StaffingVendorRequestAudit {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  requestId      String                @map("request_id") @db.Uuid
  actorId        String                @map("actor_id")
  action         String
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime              @default(now()) @map("created_at")
  request        StaffingVendorRequest @relation(fields: [requestId, organizationId], references: [id, organizationId])

  @@index([organizationId, requestId, createdAt])
  @@map("staffing_vendor_request_audit")
}

model Location {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  venueId                String                  @map("venue_id") @db.Uuid
  name                   String
  venue                  Venue                   @relation(fields: [venueId], references: [id])
  issues                 Issue[]
  tasks                  OperationalTask[]
  staffShifts            StaffShift[]
  staffingDemands        StaffingDemand[]
  hospitalityOrders      HospitalityOrder[]
  vendorStaffingRequests StaffingVendorRequest[]

  @@unique([id, venueId])
  @@unique([id, venueId, organizationId])
  @@index([organizationId, venueId])
  @@map("locations")
}

model Person {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  externalSubject        String                  @map("external_subject")
  email                  String
  displayName            String                  @map("display_name")
  active                 Boolean                 @default(true)
  provisioningSource     String                  @default("sso") @map("provisioning_source")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  auditEvents            PersonAuditEvent[]
  qualifications         PersonQualification[]
  vendorStaffingRequests StaffingVendorRequest[]
  organization           Organization            @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, externalSubject])
  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, active])
  @@map("people")
}

model PersonAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  actorId        String   @map("actor_id")
  action         String
  changedFields  String[] @map("changed_fields")
  createdAt      DateTime @default(now()) @map("created_at")
  person         Person   @relation(fields: [personId, organizationId], references: [id, organizationId], map: "person_audit_events_person_tenant_fk")

  @@index([organizationId, personId, createdAt])
  @@map("person_audit_events")
}

model Issue {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  eventId                String             @map("event_id") @db.Uuid
  venueId                String             @map("venue_id") @db.Uuid
  locationId             String?            @map("location_id") @db.Uuid
  latitude               Decimal?           @db.Decimal(8, 5)
  longitude              Decimal?           @db.Decimal(8, 5)
  locationAccuracyMeters Decimal?           @map("location_accuracy_meters") @db.Decimal(7, 2)
  locationCapturedAt     DateTime?          @map("location_captured_at") @db.Timestamptz(6)
  title                  String
  description            String
  category               String
  severity               IssueSeverity
  state                  IssueState         @default(REPORTED)
  reporterId             String             @map("reporter_id")
  ownerId                String?            @map("owner_id")
  escalationNote         String?            @map("escalation_note")
  resolutionNote         String?            @map("resolution_note")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  event                  Event              @relation(fields: [eventId], references: [id])
  location               Location?          @relation(fields: [locationId], references: [id])
  auditEvents            IssueAuditEvent[]
  notifications          UserNotification[]
  attachments            IssueAttachment[]

  @@index([organizationId, eventId, state])
  @@index([organizationId, ownerId])
  @@map("issues")
}

model IssueAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  issueId        String   @map("issue_id") @db.Uuid
  actorId        String   @map("actor_id")
  action         String
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  issue          Issue    @relation(fields: [issueId], references: [id])

  @@index([organizationId, issueId, createdAt])
  @@map("issue_audit_events")
}

model CommandReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  fingerprint    String
  action         String
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, key])
  @@map("command_receipts")
}

model IssueDomainEvent {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  issueId        String   @map("issue_id") @db.Uuid
  action         String
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, eventId, id])
  @@map("issue_events")
}

model OperationalTask {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  venueId          String                 @map("venue_id") @db.Uuid
  eventId          String                 @map("event_id") @db.Uuid
  locationId       String?                @map("location_id") @db.Uuid
  kind             OperationalTaskKind
  state            OperationalTaskState   @default(OPEN)
  title            String
  description      String                 @default("")
  ownerId          String?                @map("owner_id")
  dueAt            DateTime?              @map("due_at")
  expectedQuantity Decimal?               @map("expected_quantity") @db.Decimal(12, 3)
  actualQuantity   Decimal?               @map("actual_quantity") @db.Decimal(12, 3)
  unit             String?
  externalSource   String?                @map("external_source")
  externalTaskId   String?                @map("external_task_id")
  metadata         Json                   @default("{}") @db.JsonB
  createdBy        String                 @map("created_by")
  updatedBy        String                 @map("updated_by")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  organization     Organization           @relation(fields: [organizationId], references: [id])
  venue            Venue                  @relation(fields: [venueId], references: [id])
  event            Event                  @relation(fields: [eventId], references: [id])
  location         Location?              @relation(fields: [locationId, venueId], references: [id, venueId], map: "operational_task_location_venue_fk")
  auditEvents      OperationalTaskAudit[]

  @@unique([id, organizationId])
  @@unique([organizationId, externalSource, externalTaskId], map: "operational_tasks_org_external_task_key")
  @@index([organizationId, eventId, kind, state])
  @@index([organizationId, ownerId, dueAt])
  @@map("operational_tasks")
}

model HospitalityOrder {
  id                String                        @id @default(uuid()) @db.Uuid
  organizationId    String                        @map("organization_id") @db.Uuid
  venueId           String                        @map("venue_id") @db.Uuid
  eventId           String                        @map("event_id") @db.Uuid
  locationId        String?                       @map("location_id") @db.Uuid
  requestedBy       String                        @map("requested_by")
  assignedTo        String?                       @map("assigned_to")
  serviceAt         DateTime                      @map("service_at")
  beoReference      String?                       @map("beo_reference")
  instructions      String                        @default("")
  state             HospitalityOrderState         @default(SUBMITTED)
  rejectionReason   String?                       @map("rejection_reason")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  organization      Organization                  @relation(fields: [organizationId], references: [id])
  venue             Venue                         @relation(fields: [venueId, organizationId], references: [id, organizationId], map: "hospitality_orders_venue_tenant_fk")
  event             Event                         @relation(fields: [eventId, venueId, organizationId], references: [id, venueId, organizationId], map: "hospitality_orders_event_tenant_fk")
  location          Location?                     @relation(fields: [locationId, venueId, organizationId], references: [id, venueId, organizationId], map: "hospitality_orders_location_tenant_fk")
  lines             HospitalityOrderLine[]
  fulfillmentEvents HospitalityOrderFulfillment[]
  deliveryReceipt   HospitalityDeliveryReceipt?
  auditEvents       HospitalityOrderAudit[]
  notifications     UserNotification[]

  @@unique([id, organizationId])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, state, serviceAt])
  @@map("hospitality_orders")
}

model HospitalityOrderLine {
  id                String                        @id @default(uuid()) @db.Uuid
  organizationId    String                        @map("organization_id") @db.Uuid
  orderId           String                        @map("order_id") @db.Uuid
  itemName          String                        @map("item_name")
  quantity          Decimal                       @db.Decimal(10, 3)
  unit              String
  note              String                        @default("")
  fulfilledQuantity Decimal                       @default(0) @map("fulfilled_quantity") @db.Decimal(10, 3)
  menuItemId        String?                       @map("menu_item_id") @db.Uuid
  unitPrice         Decimal?                      @map("unit_price") @db.Decimal(10, 2)
  order             HospitalityOrder              @relation(fields: [orderId, organizationId], references: [id, organizationId], map: "hospitality_order_lines_order_tenant_fk")
  menuItem          HospitalityMenuItem?          @relation(fields: [menuItemId, organizationId], references: [id, organizationId], map: "hospitality_order_lines_menu_item_fk")
  fulfillments      HospitalityOrderFulfillment[]

  @@unique([id, orderId, organizationId])
  @@index([organizationId, orderId])
  @@map("hospitality_order_lines")
}

model HospitalityMenuItem {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  venueId        String                 @map("venue_id") @db.Uuid
  name           String
  description    String                 @default("")
  category       String                 @default("General")
  defaultUnit    String                 @default("each") @map("default_unit")
  unitPrice      Decimal                @map("unit_price") @db.Decimal(10, 2)
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  organization   Organization           @relation(fields: [organizationId], references: [id])
  venue          Venue                  @relation(fields: [venueId, organizationId], references: [id, organizationId], map: "hospitality_menu_items_venue_org_fk")
  orderLines     HospitalityOrderLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, venueId, name])
  @@index([organizationId, venueId, active, category, name])
  @@map("hospitality_menu_items")
}

model HospitalityOrderFulfillment {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  eventId            String               @map("event_id") @db.Uuid
  orderId            String               @map("order_id") @db.Uuid
  lineId             String               @map("line_id") @db.Uuid
  actorId            String               @map("actor_id")
  quantity           Decimal              @db.Decimal(10, 3)
  substituteItemName String?              @map("substitute_item_name")
  reason             String?
  createdAt          DateTime             @default(now()) @map("created_at")
  organization       Organization         @relation(fields: [organizationId], references: [id])
  order              HospitalityOrder     @relation(fields: [orderId, eventId, organizationId], references: [id, eventId, organizationId], map: "hospitality_order_fulfillments_order_tenant_fk")
  line               HospitalityOrderLine @relation(fields: [lineId, orderId, organizationId], references: [id, orderId, organizationId], map: "hospitality_order_fulfillments_line_tenant_fk")

  @@index([organizationId, eventId, orderId, createdAt])
  @@map("hospitality_order_fulfillments")
}

model HospitalityDeliveryReceipt {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  eventId               String           @map("event_id") @db.Uuid
  orderId               String           @map("order_id") @db.Uuid
  actorId               String           @map("actor_id")
  receivedByName        String           @map("received_by_name")
  note                  String           @default("")
  receiverAcknowledged  Boolean          @map("receiver_acknowledged")
  acknowledgedAt        DateTime         @default(now()) @map("acknowledged_at")
  organization          Organization     @relation(fields: [organizationId], references: [id])
  order                 HospitalityOrder @relation(fields: [orderId, eventId, organizationId], references: [id, eventId, organizationId], map: "hospitality_delivery_receipts_order_tenant_fk")

  @@unique([orderId, eventId, organizationId], map: "hospitality_delivery_receipts_once_per_order")
  @@index([organizationId, eventId, acknowledgedAt])
  @@map("hospitality_delivery_receipts")
}

model HospitalityOrderAudit {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  actorId        String           @map("actor_id")
  action         String
  before         Json?            @db.JsonB
  after          Json?            @db.JsonB
  reason         String?
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  order          HospitalityOrder @relation(fields: [orderId, organizationId], references: [id, organizationId], map: "hospitality_order_audit_tenant_fk")

  @@index([organizationId, orderId, createdAt])
  @@map("hospitality_order_audit")
}

model OperationalTaskAudit {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  taskId         String          @map("task_id") @db.Uuid
  actorId        String          @map("actor_id")
  action         String
  before         Json?           @db.JsonB
  after          Json?           @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at")
  organization   Organization    @relation(fields: [organizationId], references: [id])
  task           OperationalTask @relation(fields: [taskId, organizationId], references: [id, organizationId], map: "operational_task_audit_tenant_fk")

  @@index([organizationId, taskId, createdAt])
  @@map("operational_task_audit_events")
}

model StaffShift {
  id                         String                 @id @default(uuid()) @db.Uuid
  organizationId             String                 @map("organization_id") @db.Uuid
  venueId                    String                 @map("venue_id") @db.Uuid
  eventId                    String                 @map("event_id") @db.Uuid
  locationId                 String?                @map("location_id") @db.Uuid
  assignedSubject            String?                @map("assigned_subject")
  role                       String
  instructions               String                 @default("")
  requiredQualificationCodes String[]               @default([]) @map("required_qualification_codes")
  startsAt                   DateTime               @map("starts_at")
  endsAt                     DateTime               @map("ends_at")
  state                      StaffShiftState        @default(DRAFT)
  response                   StaffShiftResponse     @default(PENDING)
  attendance                 StaffAttendanceState   @default(NOT_STARTED)
  revision                   Int                    @default(1)
  responseRevision           Int?                   @map("response_revision")
  checkedInAt                DateTime?              @map("checked_in_at")
  checkedOutAt               DateTime?              @map("checked_out_at")
  createdBy                  String                 @map("created_by")
  updatedBy                  String                 @map("updated_by")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  organization               Organization           @relation(fields: [organizationId], references: [id])
  venue                      Venue                  @relation(fields: [venueId], references: [id])
  event                      Event                  @relation(fields: [eventId], references: [id])
  location                   Location?              @relation(fields: [locationId, venueId], references: [id, venueId], map: "staff_shifts_location_venue_fk")
  auditEvents                StaffShiftAuditEvent[]
  notifications              UserNotification[]
  breaks                     StaffBreak[]
  attendanceClaims           StaffAttendanceClaim[]
  staffingDemand             StaffingDemand?        @relation(fields: [staffingDemandId, organizationId], references: [id, organizationId], map: "staff_shifts_demand_tenant_fk")
  staffingDemandId           String?                @map("staffing_demand_id") @db.Uuid

  @@unique([id, organizationId])
  @@unique([id, eventId, organizationId], map: "staff_shifts_id_event_organization_key")
  @@index([organizationId, eventId, state, startsAt])
  @@index([organizationId, assignedSubject, startsAt])
  @@map("staff_shifts")
}

